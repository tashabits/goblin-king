{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Manifest Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset",
    "items"
  ],
  "properties": {
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "include_totals": {
      "type": "boolean",
      "default": true
    }
  }
}

