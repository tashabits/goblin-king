{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local RAG Query Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 2
    },
    "corpus_path": {
      "type": "string",
      "default": "fixtures/corpus.json"
    }
  }
}

