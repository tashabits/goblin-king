{
  "apiVersion": "goblin-king/pipeline-service/v1alpha1",
  "kind": "PipelineService",
  "context": ".",
  "dockerfile": "Dockerfile",
  "test_target": "test",
  "test_command": ["python", "-m", "unittest", "-v"],
  "background_command": ["python", "app.py", "--background"],
