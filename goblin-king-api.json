{
  "registry": "demo-goblins.json",
  "images": "demo-images.json",
  "db": ".goblin-king/goblin-king.sqlite3",
  "redis_url": "redis://localhost:6379/0",
  "artifact_root": ".goblin-king/artifacts",
  "resource_policies": "goblin-resource-policies.json",
  "auth_token": "local-dev-token",
  "bootstrap_admin_token": "local-dev-token",
  "default_project_id": null,
  "rate_limit_per_minute": 120,
  "oidc": {
    "enabled": false,
    "issuer": null,
    "audience": null,
    "jwks_url": null,
    "clock_skew_seconds": 60,
    "user_claim": "sub",
    "email_claim": "email",
    "role_claim": "goblin_king_role",
    "project_claim": "goblin_king_project_id",
    "admin_roles": ["admin"]
  },
  "repository": {
    "enabled": false,
    "url": null
  },
  "service_websocket_proxy": {
    "max_message_bytes": 1048576,
    "max_queue_messages": 16,
    "write_limit_bytes": 32768,
    "open_timeout_seconds": 10,
    "idle_timeout_seconds": 300,
    "close_timeout_seconds": 10,
    "drain_timeout_seconds": 30
  }
}
